# Copy to jenkins/.env (git-ignored) and fill in JENKINS_ADMIN_PASSWORD.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=

# 8080 belongs to the backend on this machine, and the pipeline starts the backend.
JENKINS_PORT=8090

# This repository has no git remote, so the job's SCM is the mounted working copy. Point these at
# a real remote and branch when one exists.
INVERSIONES_REPO_URL=file:///repo
INVERSIONES_BRANCH=master

# Optional: override the placeholder credentials JCasC seeds.
# JWT_SECRET_CI=
# POSTGRES_PASSWORD_CI=
# BACKEND_HOST_CI=
# ALLOWED_ORIGINS_CI=
# VERCEL_TOKEN_CI=
