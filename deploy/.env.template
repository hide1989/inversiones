# Local development defaults. Copy to .env and change nothing for local work.
POSTGRES_DB=inversiones
POSTGRES_USER=inversiones
POSTGRES_PASSWORD=inversiones_local
POSTGRES_PORT=5432

# Backend. JWT_SECRET must be at least 32 bytes; this default is for local use only.
JWT_SECRET=local-development-secret-change-me-32bytes
JWT_EXPIRATION_MINUTES=480
# Exact origins allowed to call the API cross-origin, comma-separated, no wildcard. Defaults to
# the Vite dev server Plan 3 runs.
SECURITY_ALLOWED_ORIGINS=http://localhost:5173

# n8n. The real base URL is not a secret but is environment specific.
N8N_BASE_URL=https://n8n.srv1449561.hstgr.cloud/webhook/inv
# Read timeout for /sintesis-ia only, which can take ~55s on a cold n8n cache; every other
# n8n endpoint keeps the fixed 30s timeout in application.yml.
N8N_SLOW_READ_TIMEOUT=90s

# ---------------------------------------------------------------------------
# PRODUCTION — docker-compose.prod.yml
#
# On the VPS this file lives at /docker/inversiones/.env with permissions 600.
# It is git-ignored; this template is what is tracked. The four values marked
# REQUIRED have no default in the compose file on purpose: a deploy that
# forgets one stops with a message naming it, rather than starting with a
# guessable password or an origin that silently blocks the frontend.
# ---------------------------------------------------------------------------

# REQUIRED. Generate ON THE VPS, not locally: openssl rand -base64 32
# POSTGRES_PASSWORD=

# REQUIRED. Generate ON THE VPS: openssl rand -base64 48
# At least 32 bytes. JwtCodecConfig rejects the committed local default outside
# the "local" profile, so copy-pasting it here cannot work.
# JWT_SECRET=

# REQUIRED. The hostname Traefik routes to this backend.
# *.srv1449561.hstgr.cloud is a DNS wildcard pointing at the VPS (verified), so
# any subdomain resolves there with no DNS change.
# BACKEND_HOST=api.srv1449561.hstgr.cloud

# REQUIRED. The deployed frontend's exact origin, comma-separated for several,
# never a wildcard. Fill in after Vercel assigns the production domain — until
# then the backend will reject the frontend, which is the safe direction.
# SECURITY_ALLOWED_ORIGINS=https://inversiones.vercel.app

# Optional. The image tag, so a running container is traceable to a commit.
# Jenkins sets this to the commit SHA; a manual deploy can leave it unset.
# IMAGE_TAG=

# Optional override. Inside the VPS, n8n is reachable by container name, so this
# traffic never leaves the host and the public webhook URL is not used.
# N8N_BASE_URL=http://n8n:5678/webhook/inv
