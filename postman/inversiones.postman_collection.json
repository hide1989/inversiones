            "description": "Caso negativo. Compara su cuerpo con el de «usuario inexistente»: son byte a byte idénticos a propósito, para que no se pueda enumerar qué usuarios existen.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"david\",\n  \"password\": \"contrasena-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('cuerpo RFC 7807', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('title');",
                  "  pm.expect(b).to.have.property('detail');",
                  "  pm.expect(b).to.have.property('status');",
                  "});",
                  "pm.test('mensaje genérico, no revela la causa', () => {",
                  "  pm.expect(pm.response.json().detail).to.eql('Invalid username or password');",
                  "});"
                ]
              }
            }
          ]
